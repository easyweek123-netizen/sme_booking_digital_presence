# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_APP_URL=http://localhost:5173

# Database
DB_TYPE=postgres                       # 'postgres' | 'mysql'
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bookeasy
DB_SSL=false                           # set 'true' in production

# Auth
ADMIN_SECRET=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
GOOGLE_APPLICATION_CREDENTIALS=../path-to-firebase-service-account.json
# Or in production:
# FIREBASE_SERVICE_ACCOUNT={...JSON-stringified...}

# Email (Resend)
RESEND_API_KEY=re_replace_me
EMAIL_FROM=BookEasy <onboarding@resend.dev>
ADMIN_EMAIL=admin@example.com

# AI
AI_API_KEY=sk-replace-me
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Billing
BILLING_MODE=mock                      # 'mock' | 'stripe'
MOCK_WEBHOOK_SECRET=dev-mock-secret    # Used by mock provider for signature verification utilities / tests (no HTTP webhook)
# Stripe webhook URL (Dashboard): https://<your-host>/api/billing/webhook/stripe
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# ── Calendar / Google OAuth ────────────────────────────────────────────────
# Create a NEW OAuth 2.0 Client ID inside the existing Firebase GCP project.
# Firebase service-account creds CANNOT be reused — different credential type.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Encrypts Google refresh tokens at rest (AES-256-GCM via @47ng/cloak).
# Generate with: npx @47ng/cloak generate
CLOAK_MASTER_KEY=
# Optional: comma-separated older keys for rotation. Leave empty initially.
CLOAK_KEYCHAIN=

# Signs short-lived OAuth state tokens. Independent of JWT_SECRET.
CALENDAR_OAUTH_STATE_SECRET=change-me-in-production

# ── Geocoding (OpenStreetMap Nominatim) ────────────────────────────────────
# OSM usage policy requires a contactable email for rate-limit / abuse contact.
GEOCODER_CONTACT_EMAIL=hassan.abdur.rehman@gmail.com
