{
  "name": "bookeasy",
  "version": "1.0.0",
  "description": "Mobile-first booking platform for SMEs",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "db:up": "docker compose up postgres -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run migration:run --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "local:setup": "npm run db:up && sleep 2 && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
